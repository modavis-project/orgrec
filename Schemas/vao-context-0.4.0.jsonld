{
  "@context": {
    "@version": 1.1,
    "vao": "https://w3id.org/modavis/vao/ontology#",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "sosa": "http://www.w3.org/ns/sosa/",
    "ssn": "http://www.w3.org/ns/ssn/",
    "schema": "https://schema.org/",
    "oa": "http://www.w3.org/ns/oa#",
    "qudt": "http://qudt.org/schema/qudt/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "title": "dcterms:title",
    "description": "dcterms:description",
    "createdAt": {"@id": "dcterms:created", "@type": "xsd:dateTime"},
    "modifiedAt": {"@id": "dcterms:modified", "@type": "xsd:dateTime"},
    "conformsTo": {"@id": "dcterms:conformsTo", "@type": "@id", "@container": "@set"},
    "primaryEntityId": {"@id": "schema:mainEntity", "@type": "@id"},
    "focusEntityIds": {"@id": "vao:focusEntity", "@type": "@id", "@container": "@set"},
    "profiles": {"@id": "vao:profile", "@container": "@set"},
    "materializableProfiles": {"@id": "vao:materializableProfile", "@container": "@set"},
    "entities": {"@id": "vao:entity", "@container": "@set"},
    "relations": {"@id": "vao:relation", "@container": "@set"},
    "scientific": "vao:scientific",
    "agents": {"@id": "prov:agent", "@container": "@set"},
    "activities": {"@id": "prov:activity", "@container": "@set"},
    "observations": {"@id": "sosa:Observation", "@container": "@set"},
    "analyses": {"@id": "vao:analysis", "@container": "@set"},
    "calibrations": {"@id": "ssn:implements", "@container": "@set"},
    "protocols": {"@id": "sosa:Procedure", "@container": "@set"},
    "softwareEnvironments": {"@id": "vao:softwareEnvironment", "@container": "@set"},
    "claims": {"@id": "vao:claim", "@container": "@set"},
    "reviews": {"@id": "vao:review", "@container": "@set"},
    "consents": {"@id": "vao:consent", "@container": "@set"},
    "multimodal": "vao:multimodal",
    "timebases": {"@id": "vao:timebase", "@container": "@set"},
    "tracks": {"@id": "vao:track", "@container": "@set"},
    "synchronizationMappings": {"@id": "vao:synchronizationMapping", "@container": "@set"},
    "annotations": {"@id": "oa:Annotation", "@container": "@set"},
    "physicalSystem": "vao:physicalSystem",
    "components": {"@id": "vao:component", "@container": "@set"},
    "ports": {"@id": "vao:port", "@container": "@set"},
    "connections": {"@id": "vao:connection", "@container": "@set"},
    "sensors": {"@id": "sosa:Sensor", "@container": "@set"},
    "actuators": {"@id": "sosa:Actuator", "@container": "@set"},
    "stateBindings": {"@id": "vao:stateBinding", "@container": "@set"},
    "runtime": "vao:runtime",
    "executionSemantics": "vao:executionSemantics",
    "randomSources": {"@id": "vao:randomSource", "@container": "@set"},
    "renderers": {"@id": "vao:renderer", "@container": "@set"},
    "conformanceTraces": {"@id": "vao:conformanceTrace", "@container": "@set"},
    "discovery": "vao:discovery",
    "acoustics": "vao:acoustics",
    "playable": "vao:playable",
    "interactionModel": "vao:interactionModel",
    "captureDocumentation": "vao:captureDocumentation",
    "logicalAssets": {"@id": "vao:logicalAsset", "@container": "@set"},
    "realizations": {"@id": "vao:realization", "@container": "@set"},
    "distributions": {"@id": "vao:distribution", "@container": "@set"},
    "repositoryBindings": {"@id": "vao:repositoryBinding", "@container": "@set"},
    "assetGroups": {"@id": "vao:assetGroup", "@container": "@set"},
    "rights": {"@id": "dcterms:rights", "@container": "@set"},
    "assetId": {"@id": "vao:realizesAsset", "@type": "@id"},
    "realizationIds": {"@id": "vao:hasRealization", "@type": "@id", "@container": "@set"},
    "distributionIds": {"@id": "vao:hasDistribution", "@type": "@id", "@container": "@set"},
    "rightsIds": {"@id": "dcterms:rights", "@type": "@id", "@container": "@set"},
    "provenanceIds": {"@id": "prov:wasGeneratedBy", "@type": "@id", "@container": "@set"},
    "agentIds": {"@id": "prov:wasAssociatedWith", "@type": "@id", "@container": "@set"},
    "inputIds": {"@id": "prov:used", "@type": "@id", "@container": "@set"},
    "outputIds": {"@id": "prov:generated", "@type": "@id", "@container": "@set"},
    "activityId": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "protocolId": {"@id": "sosa:usedProcedure", "@type": "@id"},
    "featureOfInterestId": {"@id": "sosa:hasFeatureOfInterest", "@type": "@id"},
    "observedProperty": {"@id": "sosa:observedProperty", "@type": "@id"},
    "result": "sosa:hasResult",
    "resultTime": {"@id": "sosa:resultTime", "@type": "xsd:dateTime"},
    "unit": {"@id": "qudt:unit", "@type": "@id"},
    "quantityKind": {"@id": "qudt:hasQuantityKind", "@type": "@id"},
    "timebaseId": {"@id": "vao:timebase", "@type": "@id"},
    "sourceTimebaseId": {"@id": "vao:sourceTimebase", "@type": "@id"},
    "targetTimebaseId": {"@id": "vao:targetTimebase", "@type": "@id"},
    "realizationId": {"@id": "vao:realization", "@type": "@id"},
    "coordinateFrameId": {"@id": "vao:coordinateFrame", "@type": "@id"},
    "componentId": {"@id": "vao:component", "@type": "@id"},
    "sourcePortId": {"@id": "vao:sourcePort", "@type": "@id"},
    "targetPortId": {"@id": "vao:targetPort", "@type": "@id"},
    "controlId": {"@id": "vao:control", "@type": "@id"},
    "eventTypeId": {"@id": "vao:eventType", "@type": "@id"},
    "stateVariableId": {"@id": "vao:stateVariable", "@type": "@id"},
    "processModelId": {"@id": "vao:processModel", "@type": "@id"},
    "generatedById": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "reviewedById": {"@id": "vao:reviewedBy", "@type": "@id"}
  }
}
