{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orgrec:schema:pod-subset:1",
  "title": "OrgRec reduced POD subset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "publicationStatus",
    "dataset",
    "source",
    "selection",
    "createdAt",
    "creators",
    "files"
  ],
  "properties": {
    "contractVersion": { "const": "orgrec-pod-subset/1" },
    "publicationStatus": { "enum": ["synthetic-fixture", "published-subset"] },
    "dataset": { "$ref": "#/$defs/dataset" },
    "source": { "$ref": "#/$defs/source" },
    "selection": { "$ref": "#/$defs/selection" },
    "createdAt": { "type": "string", "format": "date-time" },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "publicationStatus": { "const": "published-subset" } },
        "required": ["publicationStatus"]
      },
      "then": {
        "properties": {
          "dataset": { "required": ["persistentIdentifier"] },
          "source": { "required": ["versionIdentifier", "manifestSHA256"] },
          "selection": { "required": ["sourceCodeCommit"] }
        }
      }
    },
    {
      "if": {
        "properties": { "publicationStatus": { "const": "synthetic-fixture" } },
        "required": ["publicationStatus"]
      },
      "then": {
        "properties": {
          "dataset": { "not": { "required": ["persistentIdentifier"] } },
          "source": { "not": { "required": ["versionIdentifier"] } }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "format": "uri", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)~(?:/|$)).+$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "title", "version", "license", "attribution"],
      "properties": {
        "identifier": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "persistentIdentifier": { "$ref": "#/$defs/identifier" },
        "license": { "$ref": "#/$defs/identifier" },
        "attribution": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "releaseVersion"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmpty" },
        "releaseVersion": { "const": "1.5" },
        "versionIdentifier": { "$ref": "#/$defs/identifier" },
        "manifestSHA256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolIdentifier",
        "purpose",
        "method",
        "criteria",
        "fileCount",
        "sourceItemCount",
        "instrumentCount",
        "byteSize"
      ],
      "properties": {
        "protocolIdentifier": { "$ref": "#/$defs/identifier" },
        "purpose": { "$ref": "#/$defs/nonEmpty" },
        "method": { "$ref": "#/$defs/nonEmpty" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "sourceCodeCommit": { "$ref": "#/$defs/nonEmpty" },
        "seed": { "$ref": "#/$defs/nonEmpty" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "sourceItemCount": { "type": "integer", "minimum": 1 },
        "instrumentCount": { "type": "integer", "minimum": 1 },
        "byteSize": { "type": "integer", "minimum": 0 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "identifier": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "parameters"],
      "properties": {
        "activity": { "$ref": "#/$defs/nonEmpty" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceItemIdentifier",
        "sourceRelativePath",
        "path",
        "role",
        "mediaType",
        "byteSize",
        "sha256",
        "transformation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "sourceItemIdentifier": { "$ref": "#/$defs/identifier" },
        "sourceRelativePath": { "$ref": "#/$defs/safePath" },
        "path": { "$ref": "#/$defs/safePath" },
        "role": { "$ref": "#/$defs/nonEmpty" },
        "mediaType": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "instrumentIdentifier": { "$ref": "#/$defs/nonEmpty" },
        "divisionIdentifier": { "$ref": "#/$defs/nonEmpty" },
        "rankIdentifier": { "$ref": "#/$defs/nonEmpty" },
        "stopName": { "$ref": "#/$defs/nonEmpty" },
        "midiNote": { "type": "integer", "minimum": 0, "maximum": 127 },
        "channel": { "type": "integer", "minimum": 0 },
        "takeIdentifier": { "$ref": "#/$defs/nonEmpty" },
        "transformation": { "$ref": "#/$defs/transformation" }
      }
    }
  }
}
